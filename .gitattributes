# Force LF on everything that runs inside a Linux container.
#
# Why this file exists: the host is Windows 11, so git would otherwise hand
# these files CRLF line endings on checkout. A CRLF shell script inside a Linux
# container fails with "not found" — pointing at the *interpreter*, not the
# file — which reads like the script is missing. It is a genuinely miserable
# afternoon. One file prevents it permanently.

* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
Dockerfile* text eol=lf
.env*       text eol=lf
.gitignore  text eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff  binary
*.woff2 binary
