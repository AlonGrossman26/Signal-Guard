# Copy to .env and fill in every value. The app refuses to start with any of the
# secrets missing — that is deliberate (fail closed on missing config), and the
# startup error tells you the exact command to generate each one.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / Linux:    cp .env.example .env
#
# NEVER commit .env. NEVER put a real API key in this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# These three are read by the `db` container to initialise the database.
POSTGRES_USER=signalguard
POSTGRES_PASSWORD=
POSTGRES_DB=signalguard

# Read by the API. The host is the compose service name `db`, never localhost —
# the API talks to Postgres over the compose network, not via the host.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql+asyncpg://signalguard:@db:5432/signalguard

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Secrets — generate each of these, do not invent them by hand
# ---------------------------------------------------------------------------
# Master key for AES-GCM envelope encryption of broker credentials.
# Generate (32 random bytes, base64):
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
CREDENTIALS_MASTER_KEY=

# Server-side pepper mixed into the webhook endpoint_id hash, so a stolen
# database alone does not let an attacker forge webhook URLs.
# Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
ENDPOINT_ID_PEPPER=

# Signing key for session cookies.
# Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Telegram notifications (optional)
# ---------------------------------------------------------------------------
# Leave both blank to disable notifications — they are an alerting convenience,
# never a safety control, so an unconfigured bot never stops the app or a kill
# switch. Set BOTH to enable: create a bot via @BotFather for the token, and use
# your numeric chat id (message @userinfobot to find it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Live trading (constraint #2) — leave these alone
# ---------------------------------------------------------------------------
# Testnet only. Setting LIVE_TRADING_ENABLED=true ALSO requires the exact
# confirmation phrase below, or the app refuses to start. Do not turn this on
# until a later phase explicitly authorises it.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
