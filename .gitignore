# Secrets — never commit. .env.example carries the key names with empty values.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Coverage artifacts (CI runs coverage — OPS-4)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Database dumps — never commit these either.
*.sql.gz
*.dump
pgdata/

# Node / Next.js (Phase 5)
node_modules/
.next/
out/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Redis persistence files — a database dump must never be committed.
dump.rdb
*.rdb
appendonlydir/
